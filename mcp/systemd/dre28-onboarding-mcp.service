[Unit]
Description=dre28 onboarding MCP
Documentation=file:/home/ahill037/Documents/DreAnalyticaLLC/repos/dre28/mcp/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/ahill037/Documents/DreAnalyticaLLC/repos/dre28/mcp
EnvironmentFile=/home/ahill037/.config/dre28/dre28-onboarding-mcp.env
ExecStart=/usr/bin/python3 -m dre28_onboarding_mcp.server --host 127.0.0.1 --port 8790
Restart=always
RestartSec=2
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077
StandardOutput=append:/home/ahill037/.local/state/dre28/dre28-onboarding-mcp.stdout.log
StandardError=append:/home/ahill037/.local/state/dre28/dre28-onboarding-mcp.stderr.log

[Install]
WantedBy=default.target

